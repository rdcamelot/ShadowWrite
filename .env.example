# Copy this file to `.env`, then edit values.

# SHADOWWRITE_PROVIDER
# Which API adapter to use:
# - openai_compat: OpenAI-compatible chat/completions APIs (OpenAI, DeepSeek, etc.)
# - gemini: Gemini native REST API
# 选择接口适配器，openai_compat 或 gemini
SHADOWWRITE_PROVIDER=openai_compat

# SHADOWWRITE_MODEL
# Model ID for the selected provider.
# Example (openai_compat): gpt-4o-mini / deepseek-chat
# Example (gemini): gemini-2.0-flash
# 模型名（如 deepseek-chat、gpt-4o-mini、gemini-2.0-flash）
SHADOWWRITE_MODEL=gpt-4o-mini

# SHADOWWRITE_OUTPUT
# Markdown output path. Relative path is resolved from project root.
# 输出 Markdown 文件路径
SHADOWWRITE_OUTPUT=novel_draft.md

# SHADOWWRITE_TEMPERATURE
# Sampling randomness. Lower = more deterministic.
# 采样温度，越低越稳定
SHADOWWRITE_TEMPERATURE=0.7

# SHADOWWRITE_TIMEOUT_SEC
# HTTP timeout per request (seconds).
# 请求超时时间（秒）
SHADOWWRITE_TIMEOUT_SEC=120

# SHADOWWRITE_SYSTEM_PROMPT
# Optional global instruction prepended as system message.
# 全局系统提示词
SHADOWWRITE_SYSTEM_PROMPT=You are a concise fiction co-writer.

# SHADOWWRITE_STREAM
# true/false. Stream model output to terminal and markdown while generating.
# 是否开启流式输出与流式写入（true/false）
SHADOWWRITE_STREAM=true

# SHADOWWRITE_SECTION
# Optional default section label for markdown writing.
# You can also switch manually in chat via: /section <name>
# 默认分区标签（也可运行时用 /section 切换）
SHADOWWRITE_SECTION=

# SHADOWWRITE_CHAT_HTML
# true/false. Also write a chat-style HTML transcript.
# 是否额外输出聊天风格的 HTML 视图
SHADOWWRITE_CHAT_HTML=true

# SHADOWWRITE_CHAT_HTML_OUTPUT
# Optional path for chat-style HTML output.
# If empty, defaults to SHADOWWRITE_OUTPUT with ".chat.html" suffix.
# HTML 视图输出路径，留空则自动使用与 Markdown 同名的 .chat.html
SHADOWWRITE_CHAT_HTML_OUTPUT=

# SHADOWWRITE_SHOW_TIMESTAMP
# true/false. Show timestamps in visible turn headings.
# false 时默认隐藏时间，但时间仍会写入隐藏元数据注释用于索引。
SHADOWWRITE_SHOW_TIMESTAMP=false

# SHADOWWRITE_USER_INPUT_MODE
# details: user input is collapsible in markdown (viewer-dependent support)
# blockquote: fully markdown-native fallback, no collapse
# 用户输入写入模式。若 Typora 不支持 details 折叠，可改为 blockquote。
SHADOWWRITE_USER_INPUT_MODE=details

# SHADOWWRITE_RECORD
# true/false. Whether to write conversation to .md/.html files.
# Set to false for chat-only mode (no file output).
# Can be combined with SHADOWWRITE_CONTEXT_FILE independently.
# 是否将对话记录写入文件。false 时仅终端聊天，不生成 .md/.html
SHADOWWRITE_RECORD=true

# SHADOWWRITE_CONTEXT_FILE
# Context memory file (Markdown). Its content is injected into the system prompt.
# AI can update it via two marker formats:
#   - Block: <!-- context-update-start --> ... <!-- context-update-end -->
#     (structured content: settings, character profiles, architecture decisions)
#   - Inline: <!-- context-update: description -->
#     (one-line status notes, timestamped log entries)
# Use /context to view, /context update to manually trigger a summary.
#   - Empty (default): disabled, no context file
#   - "auto": auto-derive from SHADOWWRITE_OUTPUT (e.g. test_03.md → test_03_context.md)
#   - A path: use that file (relative paths resolve against output directory)
# 上下文记忆文件。留空=关闭；auto=按输出文件名自动生成；指定路径=使用该文件
# AI 支持两种标记：结构化块标记（完整设定/角色表）和行内标记（简短状态记录）
# SHADOWWRITE_CONTEXT_FILE=auto

# SHADOWWRITE_API_KEY
# Preferred generic key var for both providers.
# You may also use provider-specific aliases (see below).
# 通用 API Key（优先推荐填这个）
SHADOWWRITE_API_KEY=

# SHADOWWRITE_BASE_URL
# Base URL for openai_compat provider.
# OpenAI default: https://api.openai.com/v1
# DeepSeek example: https://api.deepseek.com/v1
# openai_compat 模式的接口基地址（DeepSeek 用 https://api.deepseek.com/v1）
SHADOWWRITE_BASE_URL=https://api.openai.com/v1

# Optional aliases recognized by the CLI:
# openai_compat:
# - OPENAI_API_KEY
# - DEEPSEEK_API_KEY
# - OPENAI_BASE_URL
# - DEEPSEEK_BASE_URL
# gemini:
# - GEMINI_API_KEY
# - GOOGLE_API_KEY

# Example profile: DeepSeek (OpenAI-compatible)
# SHADOWWRITE_PROVIDER=openai_compat
# SHADOWWRITE_MODEL=deepseek-chat
# SHADOWWRITE_BASE_URL=https://api.deepseek.com/v1
# SHADOWWRITE_API_KEY=your_deepseek_key

# Example profile: Gemini native
# SHADOWWRITE_PROVIDER=gemini
# SHADOWWRITE_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=your_gemini_key

# ─── Route 3: Local HTTP Server (shadowwrite_server.py) ───────────
# Chrome 扩展的本地 HTTP 服务端配置

# SHADOWWRITE_SERVER_HOST
# 服务绑定地址（默认 127.0.0.1，仅本机可访问）
# SHADOWWRITE_SERVER_HOST=127.0.0.1

# SHADOWWRITE_SERVER_PORT
# 服务监听端口（默认 24601，需与扩展 popup 中设置的端口一致）
# SHADOWWRITE_SERVER_PORT=24601

# SHADOWWRITE_OUTPUT_DIR
# 扩展捕获的对话输出到此目录
# 每个对话生成独立子目录：{platform}/{title}/ 下含 .md 和 .chat.html
# 默认 ./outputs
# SHADOWWRITE_OUTPUT_DIR=./outputs

# SHADOWWRITE_SERVER_CHAT_HTML
# 是否同时生成 .chat.html 格式的对话记录（默认 true）
# 设为 false 则仅生成 .md 文件，节省磁盘空间
# SHADOWWRITE_SERVER_CHAT_HTML=true
